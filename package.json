{
  "name": "@hyperjump/json-schema",
  "version": "2.0.0",
  "description": "",
  "keywords": [
    "JSON Schema"
  ],
  "author": "Jason Desrosiers <jdesrosi@gmail.com>",
  "license": "MIT",
  "repository": "github:hyperjump-io/json-schema",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/hyperjump-io"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./v1": {
      "types": "./src/dialects/v1/index.d.ts",
      "default": "./src/dialects/v1/index.js"
    },
    "./draft-04": {
      "types": "./src/dialects/draft-04/index.d.ts",
      "default": "./src/dialects/draft-04/index.js"
    },
    "./draft-06": {
      "types": "./src/dialects/draft-06/index.d.ts",
      "default": "./src/dialects/draft-06/index.js"
    },
    "./draft-07": {
      "types": "./src/dialects/draft-07/index.d.ts",
      "default": "./src/dialects/draft-07/index.js"
    },
    "./draft-2019-09": {
      "types": "./src/dialects/draft-2019-09/index.d.ts",
      "default": "./src/dialects/draft-2019-09/index.js"
    },
    "./draft-2020-12": {
      "types": "./src/dialects/draft-2020-12/index.d.ts",
      "default": "./src/dialects/draft-2020-12/index.js"
    },
    "./formats/lite": {
      "types": "./src/formats/lite.d.ts",
      "default": "./src/formats/lite.js"
    },
    "./formats/full": {
      "types": "./src/formats/full.d.ts",
      "default": "./src/formats/full.js"
    },
    "./lint": {
      "types": "./src/lint/index.d.ts",
      "default": "./src/lint/index.js"
    },
    "./lint/recommended": {
      "types": "./src/lint/recommended.d.ts",
      "default": "./src/lint/recommended.js"
    },
    "./lint/rules/*": {
      "types": "./src/lint/rules/*.d.ts",
      "default": "./src/lint/rules/*.js"
    }
  },
  "scripts": {
    "lint": "oxlint",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "bundle-size": "node benchmark/bundle-size/measure.ts",
    "version": "node scripts/version-docs.js && git add website"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "*",
    "@types/node": "*",
    "@vitest/coverage-v8": "*",
    "json-schema-test-suite": "github:json-schema-org/JSON-Schema-Test-Suite#unify",
    "oxlint": "*",
    "oxlint-tsgolint": "*",
    "typescript": "*",
    "vite": "*",
    "vitest": "*"
  },
  "dependencies": {
    "@hyperjump/browser": "file:../browser",
    "@hyperjump/json-pointer": "^1.1.3",
    "@hyperjump/json-schema-formats": "^1.0.8",
    "@hyperjump/uri": "^1.4.0",
    "@types/unist": "^3.0.3",
    "content-type": "^3.1.1",
    "unified": "^11.0.5",
    "unified-lint-rule": "^3.0.1",
    "vfile": "^6.0.3",
    "vfile-message": "^4.0.3"
  }
}
