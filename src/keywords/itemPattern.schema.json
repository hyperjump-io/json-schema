{
  "$schema": "https://json-schema.org/v1",
  "items": { "$ref": "#/$defs/item" },
  "$defs": {
    "item": {
      "anyOf": [
        { "type": ["object", "boolean"] },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/item" }
        },
        { "enum": ["*", "+", "?", "|"] }
      ]
    }
  }
}
